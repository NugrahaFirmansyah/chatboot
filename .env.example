# ============================================================
# Xmans Chatbot - Environment Configuration Template
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai.
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
# ============================================================

# Gemini API Key
GEMINI_API_KEY=

# Model AI (gemini-3.7-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview)
GEMINI_DEFAULT_MODEL=gemini-3.7-flash

# System Prompt
SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah, sopan, cerdas, dan selalu siap membantu dalam bahasa Indonesia dengan penjelasan yang jelas dan mudah dipahami.

# Mode Aplikasi: development / production
APP_ENV=development

# Kunci rahasia (WAJIB diubah!)
APP_SECRET_KEY=generate-random-string-here

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# CORS origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# SSL verification (production WAJIB true)
CURL_VERIFY_SSL=false

# Gemini settings
MAX_OUTPUT_TOKENS=4096
DEFAULT_TEMPERATURE=0.7
